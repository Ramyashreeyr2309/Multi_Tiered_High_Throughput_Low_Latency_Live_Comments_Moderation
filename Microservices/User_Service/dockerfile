FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/Microservices

COPY User_Service/requirements.txt /app/Microservices/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /app/Microservices/requirements.txt

COPY Message_Queue_Util /app/Microservices/Message_Queue_Util
COPY Token_Util /app/Microservices/Token_Util
COPY User_Service /app/Microservices/User_Service

WORKDIR /app/Microservices

EXPOSE 8001

CMD ["uvicorn", "User_Service.user_service:app", "--host", "0.0.0.0", "--port", "8001"]
