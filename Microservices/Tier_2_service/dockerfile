FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/Microservices

COPY Tier_2_Service/requirements.txt /app/Microservices/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /app/Microservices/requirements.txt

COPY Message_Queue_Util /app/Microservices/Message_Queue_Util
COPY Tier_2_Service /app/Microservices/Tier_2_Service

WORKDIR /app/Microservices

EXPOSE 8004

CMD ["uvicorn", "Tier_2_Service.tier_2_service:app", "--host", "0.0.0.0", "--port", "8004"]
