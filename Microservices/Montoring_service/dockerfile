FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/Microservices

COPY Montoring_service/requirements.txt /app/Microservices/Montoring_service/requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /app/Microservices/Montoring_service/requirements.txt

COPY Montoring_service /app/Microservices/Montoring_service

WORKDIR /app/Microservices

EXPOSE 8005

CMD ["uvicorn", "Montoring_service.monitoring_service:app", "--host", "0.0.0.0", "--port", "8005"]